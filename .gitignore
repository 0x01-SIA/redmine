# OS metadata
.DS_Store

# Local environment files
.env
.env.*
!.env.example

# Bundler local config
.bundle/config

# Runtime logs and temp data
/log/*.log
!/log/delete.me
/tmp/*
!/tmp/.keep
/coverage/
/storage/

# Uploaded and generated files
/files/*
!/files/delete.me
/public/assets/*
!/public/assets/.keep
/public/plugin_assets/*
!/public/plugin_assets/.keep

# Backup and editor temporary files
*.swp
*.swo
*.tmp
*.temp
*~
*.bak
*.backup
*.old
*.orig
